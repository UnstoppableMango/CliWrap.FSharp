{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>UnstoppableMango/renovate-config"
	],
	"automerge": true,
	"customManagers": [
		{
			"customType": "regex",
			"description": "Upstream CliWrap source for the Dummy program (cliwrap flake input)",
			"managerFilePatterns": ["/^flake\\.nix$/"],
			"matchStrings": ["\"github:Tyrrrz/CliWrap/(?<currentValue>[^\"]+)\""],
			"depNameTemplate": "Tyrrrz/CliWrap",
			"datasourceTemplate": "github-tags"
		}
	],
	"packageRules": [
		{
			"description": "CliWrap bumps cut a release. The cliwrap flake input must match the package version, so both are bumped together.",
			"groupName": "CliWrap",
			"matchPackageNames": [
				"CliWrap",
				"Tyrrrz/CliWrap"
			],
			"semanticCommitType": "fix"
		},
		{
			"description": "The library's FSharp.Core reference is the minimum version consumers need, so only a maintainer raises it. The tests and examples track the latest.",
			"matchPackageNames": [
				"FSharp.Core"
			],
			"matchFileNames": [
				"src/CliWrap.FSharp/CliWrap.FSharp.fsproj"
			],
			"enabled": false
		},
		{
			"groupName": "FSharp.Core",
			"matchPackageNames": [
				"FSharp.Core"
			]
		},
		{
			"groupName": "minver",
			"matchPackageNames": [
				"minver",
				"minver-cli"
			]
		},
		{
			"matchPackageNames": [
				"dotnet-sdk"
			],
			"versioning": "same-major"
		},
		{
			"groupName": "dotnet",
			"matchPackageNames": [
				"dotnet-sdk",
				"mcr.microsoft.com/devcontainers/dotnet"
			]
		}
	]
}
