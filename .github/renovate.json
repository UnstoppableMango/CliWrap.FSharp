{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>UnstoppableMango/renovate-config"
	],
	"automerge": true,
	"git-submodules": {
		"enabled": true
	},
	"packageRules": [
		{
			"description": "CliWrap is the only runtime dependency, so its bumps cut a release",
			"matchPackageNames": [
				"CliWrap"
			],
			"semanticCommitType": "fix"
		},
		{
			"groupName": "minver",
			"matchPackageNames": [
				"minver",
				"minver-cli"
			]
		},
		{
			"matchPackageNames": [
				"dotnet-sdk"
			],
			"versioning": "same-major"
		},
		{
			"groupName": "dotnet",
			"matchPackageNames": [
				"dotnet-sdk",
				"mcr.microsoft.com/devcontainers/dotnet"
			]
		}
	]
}
