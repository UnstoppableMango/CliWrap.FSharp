<Project>
	<Sdk Name="DotNet.ReproducibleBuilds.Isolated" Version="2.0.5" />

	<PropertyGroup>
		<Authors>UnstoppableMango</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageProjectUrl>https://github.com/UnstoppableMango/CliWrap.FSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/UnstoppableMango/CliWrap.FSharp</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<DebugType>portable</DebugType>
		<IncludeSource>true</IncludeSource>
		<NoPackageAnalysis>true</NoPackageAnalysis>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<CSharpier_Bypass>true</CSharpier_Bypass>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="All"/>
	</ItemGroup>

	<PropertyGroup>
		<MinVerTagPrefix>v</MinVerTagPrefix>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
		<!-- 1182: unused bindings, 3390: malformed XML docs -->
		<OtherFlags>$(OtherFlags) --warnon:1182 --warnon:3390</OtherFlags>
		<!--
			The implicit FSharp.Core reference follows the installed SDK. That breaks locked restores when the SDK
			rolls forward, and makes the package demand the newest FSharp.Core. Each F# project references it explicitly.
		-->
		<DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
	</PropertyGroup>
</Project>
