<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>UnMango.CliWrap.FSharp</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<UpstreamDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'vendor', 'CliWrap'))</UpstreamDir>
		<UpstreamDummyProject>$(UpstreamDir)CliWrap.Tests.Dummy/CliWrap.Tests.Dummy.csproj</UpstreamDummyProject>
		<UpstreamVersionStamp>$(UpstreamDir).upstream-version</UpstreamVersionStamp>
		<UpstreamVersion Condition="Exists('$(UpstreamVersionStamp)')">$([System.IO.File]::ReadAllText('$(UpstreamVersionStamp)').Trim())</UpstreamVersion>
		<WrappedCliWrapVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CliWrap.FSharp/CliWrap.FSharp.fsproj')), 'Include="CliWrap" Version="([^"]+)"').Groups[1].Value)</WrappedCliWrapVersion>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="CliTests.fs" />
		<Compile Include="CommandBuilderTests.fs"/>
		<None Include="packages.lock.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FsCheck" Version="3.6.0" />
		<PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
		<PackageReference Include="coverlet.collector" Version="10.1.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CliWrap.FSharp\CliWrap.FSharp.fsproj"/>
		<!-- Upstream's Dummy program, copied from the cliwrap flake input by `make vendor`.
		     It builds with upstream's own props, which don't bypass CSharpier like ours do. -->
		<ProjectReference Include="$(UpstreamDummyProject)" AdditionalProperties="CSharpier_Bypass=true" />
	</ItemGroup>

	<!-- Fail early, with a fix, when the upstream source is missing or doesn't match the wrapped CliWrap. -->
	<Target Name="CheckUpstreamSource" BeforeTargets="_GenerateRestoreGraph;CollectPackageReferences;ResolveProjectReferences">
		<Error Condition="!Exists('$(UpstreamVersionStamp)')"
		       Text="The upstream CliWrap source is missing from $(UpstreamDir). Run 'make vendor' to copy it from the cliwrap flake input." />
		<Error Condition="Exists('$(UpstreamVersionStamp)') And '$(UpstreamVersion)' != '$(WrappedCliWrapVersion)'"
		       Text="The upstream CliWrap source in $(UpstreamDir) is $(UpstreamVersion), but the library wraps CliWrap $(WrappedCliWrapVersion). Run 'make vendor' to update it." />
	</Target>

</Project>
