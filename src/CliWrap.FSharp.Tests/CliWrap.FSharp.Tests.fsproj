<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>UnMango.CliWrap.FSharp</RootNamespace>
		<RunSettingsFilePath>$(MSBuildThisFileDirectory)coverage.runsettings</RunSettingsFilePath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Equivalence.fs" />
		<Compile Include="EquivalenceTests.fs" />
		<Compile Include="Conformance/Support.fs" />
		<Compile Include="Conformance/ConfigurationSpecs.fs" />
		<Compile Include="Conformance/ExecutionSpecs.fs" />
		<Compile Include="Conformance/EnvironmentSpecs.fs" />
		<Compile Include="Conformance/CredentialsSpecs.fs" />
		<Compile Include="Conformance/PathResolutionSpecs.fs" />
		<Compile Include="Conformance/BufferingSpecs.fs" />
		<Compile Include="Conformance/ValidationSpecs.fs" />
		<Compile Include="Conformance/LineBreakSpecs.fs" />
		<Compile Include="Conformance/ResourcePolicySpecs.fs" />
		<Compile Include="Conformance/PipingSpecs.fs" />
		<Compile Include="Conformance/PullEventStreamSpecs.fs" />
		<Compile Include="Conformance/PushEventStreamSpecs.fs" />
		<Compile Include="CliTests.fs" />
		<Compile Include="CommandBuilderTests.fs"/>
		<Compile Include="PipeBuilderTests.fs" />
		<Compile Include="EventStreamTests.fs" />
		<None Include="packages.lock.json" />
		<None Include="coverage.runsettings" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FSharp.Core" Version="11.0.101" />
		<PackageReference Include="FsCheck" Version="3.6.0" />
		<PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
		<PackageReference Include="coverlet.collector" Version="10.1.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CliWrap.FSharp\CliWrap.FSharp.fsproj"/>
	</ItemGroup>

	<Import Project="Upstream.targets" />

</Project>
