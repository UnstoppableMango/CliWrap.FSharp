<?xml version="1.0" encoding="utf-8"?>
<!-- Coverlet settings for `dotnet test --collect:"XPlat Code Coverage"`. -->
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat code coverage">
				<Configuration>
					<Format>cobertura</Format>
					<!-- Only the library: the Dummy program is upstream's code. -->
					<Include>[UnMango.CliWrap.FSharp]*</Include>
					<ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
